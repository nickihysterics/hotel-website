<type>: <краткий результат в повелительной форме>

# Допустимые типы:
# feat      новая пользовательская возможность
# fix       исправление дефекта
# docs      документация
# refactor  изменение структуры без смены поведения
# test      тесты
# build     сборка и зависимости
# ci        автоматизация проверок
# chore     служебное изменение
#
# Примеры:
# feat: добавить публичную форму бронирования
# fix: исключить отменённые брони из загрузки
# docs: описать локальный запуск
