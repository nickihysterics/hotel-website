{
  "name": "nickihysterics/hotel-website",
  "description": "Hotel website, booking engine and property management system",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-zip": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.50",
    "phpstan/phpstan": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "scripts": {
    "lint": "find config public src templates -name '*.php' -print0 | xargs -0 -n1 php -l",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "stan": "phpstan analyse --memory-limit=512M",
    "check": [
      "@lint",
      "@stan",
      "@cs"
    ]
  }
}
